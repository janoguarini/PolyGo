  {
   "id": "4a6b6a0ca4",
   "es": "Dar consejos con should, ought to y had better.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "bf05d2c781",
   "es": "Should y ought to dan un consejo: You should rest, You ought to rest. Had better ('d better) es más fuerte, avisa que si no, habrá un problema: You'd better see a doctor. En negativo: You'd better not go.",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "1ed8f6779f",
   "es": "Tendrías que descansar unos días.",
   "kinds": [
    "example",
    "exercise.translation"
   ],
   "en": "You ought to rest for a few days."
  },
  {
   "id": "9fd479acae",
   "es": "Mejor que hoy no vayas a trabajar.",
   "kinds": [
    "example"
   ],
   "en": "You'd better not go to work today."
  },
  {
   "id": "649819002d",
   "es": "Das consejos con should y ought to.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "751d510a46",
   "es": "Adviertes con had better y had better not.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "7285230f69",
   "es": "Ought lleva to: ought to rest. Should va sin to: should rest.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "to"
  },
