  },
  {
   "id": "b31d2788c5",
   "es": "Preguntar y contar experiencias con el present perfect y participios irregulares.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "3e7cf1e7f2",
   "es": "Para hablar de experiencias sin decir cuándo pasaron: have/has + participio. Muchos participios son irregulares: go → gone, write → written, speak → spoken, take → taken, give → given.",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "c8484cc620",
   "es": "¿Alguna vez hablaste con una persona famosa?",
   "kinds": [
    "example",
    "exercise.translation"
   ],
   "en": "Have you ever spoken to a famous person?"
  },
  {
   "id": "f7d5440bf8",
   "es": "Escribí una historia (alguna vez).",
   "kinds": [
    "example"
   ],
   "en": "I have written a story."
  },
  {
   "id": "6248cca2c3",
   "es": "Preguntas por experiencias: Have you ever…?",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "42313d8f5d",
   "es": "Usas participios irregulares: written, spoken, taken, given.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
