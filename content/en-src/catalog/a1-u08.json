   ]
  },
  {
   "id": "7de2d48c89",
   "es": "¿Qué significa «live»?",
   "kinds": [
    "exercise.prompt"
   ]
  },
  {
   "id": "e33f327d3e",
   "es": "Escribe en inglés la acción (un verbo).",
   "kinds": [
    "exercise.translation"
   ],
   "en": "😴 🛏️"
  },
  {
   "id": "b00d9bb873",
   "es": "Ella trabaja",
   "kinds": [
    "lesson.title"
   ]
  },
  {
   "id": "6115e67448",
   "es": "La -s del presente con he, she e it.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "1260fb90ae",
   "es": "Ella trabaja en una escuela.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "She works in a school."
  },
  {
   "id": "b0c13ca8b3",
   "es": "Con he, she e it el verbo lleva -s: I work, she works.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "works"
  },
  {
   "id": "a1f1e92f5d",
   "es": "Él lee un libro todos los días.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "He reads a book every day."
  },
  {
   "id": "c20693715d",
   "es": "Mi padre va a trabajar a las ocho.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "My father goes to work at eight."
  },
  {
   "id": "5e324e1728",
   "es": "Go → goes y do → does: agregan -es.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "goes"
  },
  {
   "id": "9ee85b3111",
   "es": "Ana y Tom viven en España.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "Ana and Tom live in Spain."
  },
  {
   "id": "b608465dbc",
   "es": "Ana and Tom = they: el verbo va sin -s.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "live"
  },
  {
   "id": "0d65c4aa72",
   "es": "Study → studies: la y se cambia por -ies.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "She studies every day."
  },
  {
   "id": "4eb3099d05",
