    "exercise.translation"
   ],
   "en": "I don't work on Sunday."
  },
  {
   "id": "927f725915",
   "es": "Con I, you, we y they: don't + verbo.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "don't"
  },
  {
   "id": "cb2b4bccb8",
   "es": "Ella no come carne.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "She doesn't eat meat."
  },
  {
   "id": "40eed2ef82",
   "es": "Con he, she e it: doesn't + verbo sin -s (she doesn't eat).",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "doesn't"
  },
  {
   "id": "f601784589",
   "es": "Él no mira televisión.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "He doesn't watch TV."
  },
  {
   "id": "ae0b701996",
   "es": "Después de doesn't el verbo va sin -s.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "watch"
  },
  {
