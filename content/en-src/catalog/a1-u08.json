    "lesson.objective"
   ]
  },
  {
   "id": "baec093a06",
   "es": "¿Qué significa «I don't drink coffee.»?",
   "kinds": [
    "exercise.prompt"
   ]
  },
  {
   "id": "2d121377dd",
   "es": "Tomo café.",
   "kinds": [
    "exercise.option"
   ]
  },
  {
   "id": "af1beaddbe",
   "es": "No quiero café.",
   "kinds": [
    "exercise.option"
   ]
  },
  {
