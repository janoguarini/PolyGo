   ],
   "en": "She doesn't work."
  },
  {
   "id": "b0ac64773a",
   "es": "Negativa: don't + verbo. I don't drink coffee.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "I don't drink coffee."
  },
  {
   "id": "5d5276834f",
   "es": "Con he/she: doesn't + verbo sin -s. She doesn't work.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "She doesn't work at home."
  },
  {
   "id": "c5245e4d74",
   "es": "Pregunta: Do + you + verbo. Do you live…?",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "Do you live in Spain?"
  },
  {
   "id": "8709f24407",
