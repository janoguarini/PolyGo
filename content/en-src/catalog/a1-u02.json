  },
  {
   "id": "56ac0ac5cb",
   "es": "Formar oraciones negativas y preguntas con to be.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "5a2efafe6f",
   "es": "Para negar, not va después de to be: I am not, she is not (isn’t). Para preguntar, el verbo va primero: Are you tired?",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "282b5e6e14",
   "es": "¿Ella es estudiante?",
   "kinds": [
    "example"
   ],
   "en": "Is she a student?"
  },
  {
   "id": "9e9e0dc355",
   "es": "Niegas con not después de am, is o are.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "471b1dddb6",
   "es": "Preguntas poniendo el verbo primero: Are you…?",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "c7ac5efea3",
   "es": "Para negar con to be se usa not después del verbo: I am not.",
   "kinds": [
