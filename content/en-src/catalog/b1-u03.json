  {
   "id": "3a9a77bfc7",
   "es": "La escena",
   "kinds": [
    "lesson.title"
   ]
  },
  {
   "id": "db436b24e7",
   "es": "Armar la escena de una anécdota con el past continuous y el past simple.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "8ab8949dd1",
   "es": "Una anécdota suele empezar con la escena (past continuous: I was having lunch) y sigue con lo que pasó (past simple: when a man said my name). Para reaccionar: strange (raro), surprised (sorprendido), embarrassed (avergonzado).",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "ad46b9ebd8",
   "es": "Estaba almorzando cuando un hombre dijo mi nombre.",
   "kinds": [
    "example",
    "exercise.translation"
   ],
   "en": "I was having lunch when a man said my name."
  },
  {
   "id": "be06e88c9b",
   "es": "Hoy pasó algo raro.",
   "kinds": [
    "example",
    "exercise.source"
   ],
   "en": "A strange thing happened today."
  },
  {
   "id": "e38eeb5ccf",
   "es": "Armas la escena con was/were + -ing y cuentas lo que pasó en past simple.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "abff68e49e",
   "es": "Dices cómo te sentiste: surprised, embarrassed.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "244b43b337",
   "es": "La escena (lo que estaba pasando) va en past continuous.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "was having"
  },
  {
