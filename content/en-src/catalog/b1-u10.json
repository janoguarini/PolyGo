  {
   "id": "752a248d1e",
   "es": "Dijo que…",
   "kinds": [
    "lesson.title"
   ]
  },
  {
   "id": "d9f6a41c2b",
   "es": "Contar lo que alguien dijo: said that, told me that.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "aa235f9db2",
   "es": "Said va sin persona (He said that…) y told, con persona (He told me that…). El verbo va un tiempo atrás: «I am busy» → She said she was busy; «We will hire» → He said they would hire; «You can go» → He told us we could go. That se puede omitir.",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "bcb5fe495c",
   "es": "Dijo que estaba ocupada.",
   "kinds": [
    "example"
   ],
   "en": "She said that she was busy."
  },
  {
   "id": "cf78937f35",
   "es": "Nos dijo que podíamos trabajar desde casa.",
   "kinds": [
    "example"
   ],
   "en": "He told us that we could work from home."
  },
  {
   "id": "4f10c9a9cb",
   "es": "Cuentas lo que alguien dijo con said y told.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "a03056fa43",
   "es": "Pasas el verbo un tiempo atrás: is → was, will → would, can → could.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "d4192166d5",
   "es": "«Estoy ocupada.» → Dijo que estaba ocupada.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "«I am busy.» → She said that she was busy."
  },
  {
   "id": "19b6e788d1",
   "es": "En estilo indirecto, am/is pasa a was.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "was"
  },
  {
   "id": "d3c3859284",
   "es": "Told + persona (told me); said sin persona (he said that…).",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "told"
  },
  {
   "id": "94edd119ad",
   "es": "«Te voy a ayudar.» → Dijo que me iba a ayudar.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "«I will help you.» → She said she would help me."
  },
  {
   "id": "fabdd65605",
   "es": "Will pasa a would.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "would"
  },
