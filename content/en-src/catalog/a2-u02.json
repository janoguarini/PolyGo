  {
   "id": "d0ae0939f5",
   "es": "La ortografía del -ed",
   "kinds": [
    "lesson.title"
   ]
  },
  {
   "id": "1fb2c6a21e",
   "es": "study → studied, live → lived, try → tried.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "1a3717b0dd",
   "es": "estudié (study)",
   "kinds": [
    "exercise.hint"
   ],
   "en": "studied"
  },
  {
   "id": "3d09e287ca",
   "es": "Consonante + y → -ied: study → studied.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "studied"
  },
  {
   "id": "82ded357ca",
   "es": "Viví en México dos años.",
   "kinds": [
    "exercise.translation"
   ],
   "en": "I lived in Mexico for two years."
  },
  {
   "id": "4868497725",
   "es": "Si el verbo termina en -e, sólo se agrega -d: live → lived.",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "lived"
  },
