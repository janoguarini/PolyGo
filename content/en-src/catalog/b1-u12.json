  {
   "id": "fe5caf66ff",
   "es": "Explicar causas, consecuencias y contrastes con conectores.",
   "kinds": [
    "lesson.objective"
   ]
  },
  {
   "id": "d52fae4ff2",
   "es": "Because of va con un sustantivo (because of the storm); because, con una oración. Therefore (por lo tanto) da la consecuencia. Although (aunque) une dos ideas en una oración; however (sin embargo) empieza la oración siguiente.",
   "kinds": [
    "lesson.intro"
   ]
  },
  {
   "id": "60315dc685",
   "es": "Explicas causas con because of y consecuencias con therefore.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "d0595cb37e",
   "es": "Muestras contrastes con although y however.",
   "kinds": [
    "lesson.takeaway"
   ]
  },
  {
   "id": "d96589d297",
   "es": "Because of + sustantivo (the snow); because + oración (because it snowed).",
   "kinds": [
    "exercise.explanation"
   ],
   "en": "because of"
  },
