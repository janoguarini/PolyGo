# Copiá este archivo a .env y completá con los valores de TU proyecto Supabase.
# Solo valores PÚBLICOS: la URL y la anon/publishable key. Nunca la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# URL del servidor de partidas (Fase 4). Vacío = Ranked deshabilitado con aviso.
EXPO_PUBLIC_BATTLE_SERVER_URL=
