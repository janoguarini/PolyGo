# Copiá este archivo a .env y completá con los valores de TU proyecto Supabase.
# Solo valores PÚBLICOS: la URL y la anon/publishable key. Nunca la service_role key.
# Detalle y validación: docs/ENVIRONMENT.md · npm run env:check [-- --production]

# Obligatorias siempre.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Servidor de partidas. Desarrollo: vacío = Ranked legacy por Supabase; se admite http en la red local.
# Preview/production la toman de eas.json (https); allí vacía o inválida = Ranked deshabilitado con aviso.
EXPO_PUBLIC_BATTLE_SERVER_URL=
# Obligatoria en producción (https; las tiendas la exigen). Vacío = no se muestra el enlace.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
