{
  "expo": {
    "name": "PolyGo",
    "slug": "polygo",
    "owner": "lichigap",
    "version": "0.1.0",
    "scheme": "polygo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0A1A",
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "pt-BR": "./locales/pt-BR.json",
      "it": "./locales/it.json",
      "fr": "./locales/fr.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polygoidiomas.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.polygoidioma.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0A1A"
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "PolygoWord",
              "displayName": "Palabra",
              "description": "Palabra del día y tus palabras para repasar, con pronunciación y ejemplo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/PolygoWord.ios.tsx"
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 110,
                "initialLayout": "./src/widgets/PolygoWord.android.tsx"
              }
            },
            {
              "name": "PolygoQuiz",
              "displayName": "Pregunta rápida",
              "description": "Responde preguntas de vocabulario desde la pantalla de inicio.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "./src/widgets/PolygoQuiz.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180,
                "initialLayout": "./src/widgets/PolygoQuiz.android.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "PolyGo usa el micrófono sólo para los ejercicios de hablar: escucha tu respuesta y la compara con la frase. No guarda tu voz."
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "PolyGo usa tus fotos sólo para que elijas tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#7C3AED",
          "defaultChannel": "daily-reminder",
          "enableRemoteNotifications": true
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en",
              "pt-BR",
              "it",
              "fr"
            ],
            "android": [
              "es",
              "en",
              "pt-BR",
              "it",
              "fr"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "PolyGo usa este permiso para medir qué anuncios te trajeron a la app y mostrarte publicidad más relevante. No vendemos tus datos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PolyGo usa el micrófono sólo para los ejercicios de hablar: escucha tu respuesta y la compara con la frase. No guarda tu voz.",
          "speechRecognitionPermission": "PolyGo transcribe tu voz en los ejercicios de hablar para corregir tu pronunciación de la frase.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.polygoidiomas.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.polygoidiomas.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "017ba1de-9d78-4f94-8cbb-d3ef3654629c"
      }
    }
  }
}
