{
  "name": "polygo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.25",
    "lucide-react-native": "^1.63.0",
    "posthog-react-native": "^4.87.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-purchases": "^11.0.4",
    "react-native-purchases-ui": "^11.0.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "jest",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test -- --ci && npm run test:db && npm run test:server && npm run website:build",
    "test:ops": "node --import tsx --test ops/learning-session/verify.test.mjs",
    "test:db": "node --import tsx --test \"supabase/tests/*.test.mjs\"",
    "content:sql": "tsx scripts/build-content-sql.ts",
    "content:dump": "tsx scripts/dump-content.ts",
    "content:diff": "tsx scripts/build-content-diff-sql.ts",
    "content:catalog": "tsx scripts/build-catalog-sql.ts",
    "content:ids": "tsx scripts/content-ids.ts",
    "content:comprehension": "tsx scripts/build-comprehension-sql.ts",
    "content:planned": "tsx scripts/build-planned-units-sql.ts",
    "content:a1-closure": "tsx scripts/build-a1-closure-sql.ts",
    "content:a2": "tsx scripts/build-a2-expansion-sql.ts",
    "content:a2-publish": "tsx scripts/build-a2-publish-sql.ts",
    "content:b1": "tsx scripts/build-b1-sql.ts",
    "content:b1-publish": "tsx scripts/build-b1-publish-sql.ts",
    "content:b2": "tsx scripts/build-b2-sql.ts",
    "content:b2-publish": "tsx scripts/build-b2-publish-sql.ts",
    "content:pt": "tsx scripts/build-pt-sql.ts",
    "content:pt-publish": "tsx scripts/build-pt-publish-sql.ts",
    "content:it": "tsx scripts/build-it-sql.ts",
    "content:it-publish": "tsx scripts/build-it-publish-sql.ts",
    "content:zh": "tsx scripts/build-zh-sql.ts",
    "content:zh-publish": "tsx scripts/build-zh-publish-sql.ts",
    "content:fr": "tsx scripts/build-fr-sql.ts",
    "content:fr-publish": "tsx scripts/build-fr-publish-sql.ts",
    "content:es": "tsx scripts/build-es-sql.ts",
    "content:es-publish": "tsx scripts/build-es-publish-sql.ts",
    "content:visual": "tsx scripts/stimulus-visual-info.ts",
    "content:placement": "tsx scripts/build-placement-bank.ts",
    "test:server": "npm --prefix server run typecheck && npm --prefix server test",
    "website:build": "node website/build.mjs",
    "website:emblems": "tsx scripts/generate-website-emblems.ts",
    "functions:build": "tsx scripts/build-functions.ts",
    "env:check": "tsx scripts/check-env.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/server/",
      "/batch/",
      "/supabase/",
      "/ops/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
