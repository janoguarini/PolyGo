{
  "name": "polygo-battle-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor autoritativo de partidas Word Rush (Socket.IO). Ver docs/BATTLE_PROTOCOL.md.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3"
  }
}
